# ==============================================================================
# Renbee Proposal Extractor - Environment Variables Configuration Template
# ==============================================================================

# 1. Google Gemini API Key (Google AI Studio)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# 2. UK Government Domestic EPC Register API (Bearer Token)
# Register at: https://epc.opendatacommunities.org/docs/api
EPC_API_KEY=YOUR_EPC_API_KEY_HERE

# 3. UK Companies House Official Business Register API Key
# Register at: https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=YOUR_COMPANIES_HOUSE_API_KEY_HERE

# 4. Server Configuration
PORT=8000
HOST=0.0.0.0
